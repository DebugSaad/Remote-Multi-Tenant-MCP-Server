# ==============================================================================
# Remote Multi-Tenant MCP Server - Environment Configuration Template
# ==============================================================================

# Application & Gateway Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=1048576  # 1 MB

# Server Public Resource URL (used for JWT audience verification)
MCP_RESOURCE_URL=http://localhost:8000

# Docker & PostgreSQL Configuration
POSTGRES_DB=mcp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_superuser_password
APP_USER_PASSWORD=your_secure_app_user_password
APP_ADMIN_PASSWORD=your_secure_app_admin_password
POSTGRES_PORT=5433

# Database Connections (SQLAlchemy 2 async with asyncpg)
# 1. Standard tenant requests (strictly subject to Row-Level Security)
DATABASE_URL=postgresql+asyncpg://app_user:your_secure_app_user_password@localhost:5433/mcp_db

# 2. Migration & schema DDL operations (connects as owner/superuser postgres)
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_superuser_password@localhost:5433/mcp_db

# 3. Dedicated admin pool (for audit inspection & user status toggle only)
ADMIN_DATABASE_URL=postgresql+asyncpg://app_admin:your_secure_app_admin_password@localhost:5433/mcp_db

# Redis Configuration (Rate Limiting, Session Store, SSE Event Buffer)
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@localhost:6379/0

# Rate Limiting Parameters (Token Bucket)
RATE_LIMIT_BURST=20
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WRITE_COST=2

# Session Management
SESSION_TTL_SECONDS=1800  # 30 minutes sliding window

# Identity & OAuth 2.1 Settings (Keycloak)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password
KEYCLOAK_PORT=8080
AUTH_ISSUER_URL=http://localhost:8080/realms/mcp
AUTH_JWKS_URL=http://localhost:8080/realms/mcp/protocol/openid-connect/certs
ADMIN_ROLE_NAME=admin
